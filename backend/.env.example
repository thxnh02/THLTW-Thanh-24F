APP_NAME="CT_24F Catalog API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_thltw
DB_USERNAME=root
DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=127.0.0.1,::1
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:3000,localhost:3000,127.0.0.1:8000,localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-sender@gmail.com
MAIL_FROM_NAME=CT_24F

# Only for the optional local AdminExampleSeeder. Set a unique 12+ character password.
ADMIN_EXAMPLE_EMAIL=admin@example.test
ADMIN_EXAMPLE_PASSWORD=

# COD orders are paid to the courier on delivery. Enable explicitly where you accept COD.
COD_ENABLED=false
ORDER_EMAIL_ENABLED=false
ORDER_ADMIN_EMAIL=
ORDER_EMAIL_MAX_ATTEMPTS=3
ORDER_EMAIL_BACKOFF_SECONDS=60,300,900
ORDER_EMAIL_STALE_AFTER_SECONDS=300
FRONTEND_URL=http://127.0.0.1:3000
VNPAY_ENABLED=false
VNPAY_ENV=sandbox
VNPAY_QUERY_ENABLED=false
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERY_IP=127.0.0.1
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
